---
import { betrieb } from '../inhalt/betrieb.js';
import { pfad } from '../inhalt/pfad.js';
---

<header class="leiste">
  <a class="heim" href={pfad('/')} aria-label={`${betrieb.name}, zur Startseite`}><span class="logo"></span></a>
  <nav aria-label="Hauptnavigation">
    <a href={pfad('/#marken')}>Marken</a>
    <a href={pfad('/#laden')}>Der Laden</a>
    <a href={pfad('/#beratung')}>Beratung</a>
    <a href={pfad('/#brustprothesen')}>Brustprothesen</a>
  </nav>
  <a class="knopf" href={pfad('/#besuch')}>Besuch planen</a>
</header>

<style>
  .leiste {
    position: fixed;
    z-index: 20;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px 26px;
    width: min(100% - 28px, 860px);
    padding: 8px 8px 8px 22px;
    border-radius: 999px;
    background: rgb(238 240 234 / 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 10px 40px rgb(24 34 30 / 0.14);
  }
  .heim {
    display: block;
    padding: 6px 0;
    color: var(--se-tinte);
  }
  .logo {
    width: 92px;
  }
  nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
    font-size: 15px;
  }
  nav a {
    padding: 12px 0;
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .leiste {
      padding-left: 16px;
    }
    .logo {
      width: 76px;
    }
    nav {
      display: none;
    }
    .knopf {
      margin-left: auto;
    }
  }
</style>
