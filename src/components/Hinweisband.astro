---
import { gueltigerHinweis } from '../inhalt/hinweis.js';
const text = gueltigerHinweis();
---

{
  text && (
    <aside class="band" aria-label="Aktueller Hinweis">
      <p>{text}</p>
    </aside>
  )
}

<style>
  /* Das Band steht fest am oberen Rand, die schwebende Leiste rückt um seine Höhe nach unten. */
  .band {
    position: fixed;
    z-index: 21;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    place-items: center;
    block-size: var(--band-h);
    padding-inline: 16px;
    background: var(--se-espresso);
    color: var(--se-papier);
    font-size: var(--fs-klein);
    line-height: 1.3;
    text-align: center;
  }
  .band p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  @media (max-width: 480px) {
    .band p {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
  }
</style>
