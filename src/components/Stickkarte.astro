---
// Die Umgebung des Ladens als Muster auf einem Seidentuch, von oben gesehen und leicht zerknittert.
// Strassen, Schrift und Saum folgen den Falten; Glanz und Schatten liegen als Lichtbild darüber.
// Ein Klick öffnet die Routenplanung. Mit Bewegung sticht sich die Karte Stich für Stich, sobald sie ins Bild kommt.
import { Image } from 'astro:assets';
import lichtbild from '../assets/bilder/tuch-licht.png';
import { betrieb, route } from '../inhalt/betrieb.js';
import { karte } from '../inhalt/karte.js';
import { FLAECHE, alsPunkte, linie, umriss, verzogen } from '../inhalt/tuch.js';

const meter = Math.round(Math.hypot(...karte.bahnhof) / 50) * 50;
const text = `Karte auf einem Seidentuch: ${betrieb.name} an der ${betrieb.strasse}, rund ${meter} Meter vom Bahnhof ${betrieb.ort}. Route planen`;
const arten = ['neben', 'haupt', 'weg-zu-uns'];
const wege = karte.wege.map((weg) => ({ art: weg.art, punkte: alsPunkte(linie(weg.punkte.split(' ').map((p) => p.split(',').map(Number)))) }));
const [bx, by] = verzogen(...karte.bahnhof);
const [mx, my] = verzogen(...karte.marktplatz);
const [sx, sy] = verzogen(140, -78);
const [wx, wy] = verzogen(0, 0);
const rahmen = `${FLAECHE.x} ${FLAECHE.y} ${FLAECHE.seite} ${FLAECHE.seite}`;
---

<figure class="stick">
  <a class="tuch" href={route} rel="noopener" data-karte>
    <svg viewBox={rahmen} role="img" aria-label={text} focusable="false">
      <defs>
        <clipPath id="tuchrand"><polygon points={alsPunkte(umriss(4))}></polygon></clipPath>
        <mask id="stich" maskUnits="userSpaceOnUse" x={FLAECHE.x} y={FLAECHE.y} width={FLAECHE.seite} height={FLAECHE.seite}>
          {wege.map((weg) => <polyline class="spur" points={weg.punkte} pathLength="1" />)}
        </mask>
      </defs>
      <polygon class="stoff" points={alsPunkte(umriss())}></polygon>
      <polygon class="saum" points={alsPunkte(umriss(11))}></polygon>
      <g clip-path="url(#tuchrand)">
      <g mask="url(#stich)">
        {arten.flatMap((art) => wege.filter((weg) => weg.art === art).map((weg) => <polyline class={`faden ${art}`} points={weg.punkte} />))}
      </g>
      </g>
      <g class="orte">
        <rect class="haus" x={bx - 26} y={by - 12} width="52" height="24" rx="3"></rect>
        <text x={bx} y={by + 44}>Bahnhof</text>
        <text class="klein" x={mx - 62} y={my + 34}>Marktplatz</text>
        <text class="strasse" x={sx} y={sy} transform={`rotate(-57 ${sx} ${sy})`}>Bahnhofstrasse</text>
      </g>
      <g class="wir" transform={`translate(${wx} ${wy})`}>
        <circle r="21"></circle>
        <path d="M-9,-9 L9,9 M9,-9 L-9,9 M0,-12 L0,12 M-12,0 L12,0"></path>
        <text x="34" y="10">hier sind wir</text>
      </g>
    </svg>
    <Image class="licht" src={lichtbild} alt="" widths={[520, 1000]} sizes="(max-width: 600px) 90vw, 520px" quality={80} />
  </a>
  <figcaption>Kartendaten © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap-Mitwirkende</a></figcaption>
</figure>

<style>
  .stick {
    --tuch: #cfd8cb;
    --faden-fein: var(--se-moos);
    width: min(100%, 520px);
  }
  .tuch {
    position: relative;
    display: block;
    isolation: isolate;
    rotate: -3deg;
    transition: rotate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tuch:hover {
    rotate: -1deg;
  }
  .licht {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: hard-light;
    pointer-events: none;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .stoff {
    fill: var(--tuch);
    filter: drop-shadow(0 14px 16px rgb(65 54 48 / 0.28));
  }
  .saum {
    fill: none;
    stroke: var(--faden-fein);
    stroke-width: 1.6;
    stroke-dasharray: 5 4;
    opacity: 0.6;
  }
  .faden {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .faden.neben {
    stroke: var(--se-moos);
    stroke-width: 3;
    stroke-dasharray: 8 7;
    opacity: 0.75;
  }
  .faden.haupt {
    stroke: var(--se-tinte);
    stroke-width: 4.5;
    stroke-dasharray: 12 7;
  }
  .faden.weg-zu-uns {
    stroke: var(--se-koralle);
    stroke-width: 7.5;
    stroke-dasharray: 15 8;
  }
  .spur {
    fill: none;
    stroke: #fff;
    stroke-width: 14;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .orte text,
  .wir text {
    font-family: var(--se-font-titel);
    font-size: 30px;
    font-style: italic;
    fill: var(--se-tinte);
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--tuch);
    stroke-width: 7px;
    stroke-linejoin: round;
  }
  .orte .klein {
    font-size: 24px;
  }
  .orte .strasse {
    font-size: 23px;
    fill: var(--se-koralle);
  }
  .haus {
    fill: none;
    stroke: var(--se-tinte);
    stroke-width: 3.5;
    stroke-dasharray: 8 5;
    stroke-linecap: round;
  }
  .wir circle {
    fill: var(--tuch);
    stroke: var(--se-koralle);
    stroke-width: 4.5;
    stroke-dasharray: 9 5;
    stroke-linecap: round;
  }
  .wir path {
    fill: none;
    stroke: var(--se-koralle);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .wir text {
    font-size: 34px;
    text-anchor: start;
    paint-order: stroke;
    stroke: var(--tuch);
    stroke-width: 9px;
    stroke-linejoin: round;
  }
  figcaption {
    margin-top: 10px;
    color: var(--se-moos);
    font-size: 12px;
    text-align: center;
  }
  figcaption a {
    display: inline-block;
    padding: 6px 0;
  }
  /* Mit Bewegung: Die Fäden erscheinen entlang der Strassen, die Bahnhofstrasse zuletzt. Das Skript setzt die Reihenfolge. */
  :global(.bewegt) .spur {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(.bewegt) .schreibt .spur {
    animation: stechen 1.1s ease-out forwards;
    animation-delay: calc(var(--i) * 70ms);
  }
  :global(.bewegt) .wir,
  :global(.bewegt) .orte {
    opacity: 0;
  }
  :global(.bewegt) .schreibt .wir,
  :global(.bewegt) .schreibt .orte {
    opacity: 1;
    transition: opacity 0.6s 1.9s;
  }
  @keyframes stechen {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
