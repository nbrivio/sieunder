---
import Betont from './Betont.astro';
import { betrieb, telefonZiel, telefonAnzeige, zeitenZeilen } from '../inhalt/betrieb.js';
import { start } from '../inhalt/start.js';
import { pfad } from '../inhalt/pfad.js';
---

<footer id="besuch" class="fuss">
  <span class="logo" role="img" aria-label={betrieb.name}></span>
  <h2 class="gross"><Betont text={start.besuch} /></h2>
  <div class="spalten">
    <div>
      <h3>Adresse</h3>
      <address>{betrieb.firma}<br />{betrieb.strasse}<br />{betrieb.plz} {betrieb.ort}</address>
    </div>
    <div class="breit">
      <h3>Öffnungszeiten</h3>
      <dl>
        {zeitenZeilen.map((zeile) => (<div><dt>{zeile.tage}</dt><dd>{zeile.text}</dd></div>))}
      </dl>
    </div>
    <div>
      <h3>Kontakt</h3>
      <ul>
        <li><a href={telefonZiel}>{telefonAnzeige}</a></li>
        <li><a href={`mailto:${betrieb.email}`}>{betrieb.email}</a></li>
        <li><a href={betrieb.instagram} rel="noopener">Instagram</a></li>
        <li><a href={betrieb.facebook} rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <nav class="klein" aria-label="Weitere Seiten">
    <a href={pfad('/marken/')}>Marken</a>
    <a href={pfad('/ueber-uns/')}>Über uns</a>
    <a href={pfad('/beratung/brustprothesen/')}>Brustprothesen</a>
    <a href={pfad('/impressum/')}>Impressum</a>
    <a href={pfad('/datenschutz/')}>Datenschutz</a>
  </nav>
</footer>

<style>
  .fuss {
    padding: clamp(48px, 7vw, 100px) var(--rand);
    background: var(--se-tanne);
    color: var(--se-papier);
  }
  .logo {
    width: 150px;
  }
  h2 {
    margin: 36px 0 48px;
    font-size: clamp(40px, 6vw, 92px);
    line-height: 0.98;
  }
  .spalten {
    display: flex;
    flex-wrap: wrap;
    gap: 36px 72px;
  }
  .spalten > div {
    flex: 1 1 220px;
  }
  .spalten > .breit {
    flex-basis: 300px;
  }
  h3 {
    margin-bottom: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  dl > div + div {
    margin-top: 10px;
  }
  dt {
    font-weight: 600;
  }
  .klein {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid rgb(238 240 234 / 0.25);
    font-size: 15px;
  }
  a {
    display: inline-block;
    padding: 8px 0;
  }
  a:hover {
    color: var(--se-rose);
  }
  a:focus-visible {
    outline-color: var(--se-papier);
  }
</style>
