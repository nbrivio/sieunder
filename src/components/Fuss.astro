---
import Betont from './Betont.astro';
import Handschrift from './Handschrift.astro';
import { betrieb, route, telefonZiel, telefonAnzeige, zeitenZeilen } from '../inhalt/betrieb.js';
import { start } from '../inhalt/start.js';
import { pfad } from '../inhalt/pfad.js';
---

<footer id="besuch" class="fuss">
  <div class="oben">
    <span class="logo" role="img" aria-label={betrieb.name}></span>
    <ul class="sozial">
      <li>
        <a href={betrieb.instagram} rel="noopener" aria-label={`${betrieb.name} auf Instagram`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle class="voll" cx="17.2" cy="6.8" r="1"></circle></svg>
        </a>
      </li>
      <li>
        <a href={betrieb.facebook} rel="noopener" aria-label={`${betrieb.name} auf Facebook`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 8.5V7c0-.8.5-1.3 1.4-1.3H17V3h-2.3C12.3 3 11 4.5 11 6.8v1.7H9v2.8h2V21h3v-9.7h2.5l.5-2.8z"></path></svg>
        </a>
      </li>
    </ul>
  </div>
  <Handschrift />
  <h2 class="gross"><Betont text={start.besuch} /></h2>
  <div class="spalten">
    <div>
      <h3>Adresse</h3>
      <address>{betrieb.firma}<br />{betrieb.strasse}<br />{betrieb.plz} {betrieb.ort}</address>
      <p><a href={route} rel="noopener">Route planen</a></p>
    </div>
    <div class="breit">
      <h3>Öffnungszeiten</h3>
      <dl>
        {zeitenZeilen.map((zeile) => (<div><dt>{zeile.tage}</dt><dd>{zeile.text}</dd></div>))}
      </dl>
    </div>
    <div>
      <h3>Kontakt</h3>
      <ul>
        <li><a href={telefonZiel}>{telefonAnzeige}</a></li>
        <li><a href={`mailto:${betrieb.email}`}>{betrieb.email}</a></li>
      </ul>
    </div>
  </div>
  <nav class="klein" aria-label="Weitere Seiten">
    <a href={pfad('/marken/')}>Marken</a>
    <a href={pfad('/ueber-uns/')}>Über uns</a>
    <a href={pfad('/beratung/brustprothesen/')}>Brustprothesen</a>
    <a href={pfad('/impressum/')}>Impressum</a>
    <a href={pfad('/datenschutz/')}>Datenschutz</a>
  </nav>
</footer>

<style>
  .fuss {
    padding: clamp(48px, 7vw, 100px) var(--rand);
    background: var(--se-espresso);
    color: var(--se-papier);
  }
  .oben {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .logo {
    width: 150px;
  }
  .sozial {
    display: flex;
    gap: 10px;
  }
  .sozial a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid rgb(238 240 234 / 0.4);
    border-radius: 50%;
  }
  .sozial a:hover {
    border-color: var(--se-rose);
  }
  .sozial svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .sozial .voll {
    fill: currentColor;
    stroke: none;
  }
  h2 {
    margin: 20px 0 48px;
    font-size: clamp(40px, 6vw, 92px);
    line-height: 0.98;
  }
  .spalten {
    display: flex;
    flex-wrap: wrap;
    gap: 36px 72px;
  }
  .spalten > div {
    flex: 1 1 220px;
  }
  .spalten > .breit {
    flex-basis: 300px;
  }
  h3 {
    margin-bottom: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  dl > div + div {
    margin-top: 10px;
  }
  dt {
    font-weight: 600;
  }
  .klein {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid rgb(238 240 234 / 0.25);
    font-size: 15px;
  }
  a {
    display: inline-block;
    padding: 8px 0;
  }
  a:hover {
    color: var(--se-rose);
  }
  a:focus-visible {
    outline-color: var(--se-papier);
  }
</style>
