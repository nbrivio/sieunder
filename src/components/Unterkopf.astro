---
// Kopf der Unterseiten: Titel und Einstieg links, daneben ein Bild als Blickfang.
// Das Bild ist das grösste Element der Seite und lädt deshalb sofort.
import { Image } from 'astro:assets';
import Betont from './Betont.astro';

const { titel, lead, bild, alt } = Astro.props;
---

<header class="u-kopf">
  <h1 class="gross"><Betont text={titel} /></h1>
  <figure class="u-blick"><Image src={bild} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 92vw, 42vw" quality={72} loading="eager" fetchpriority="high" /></figure>
  <p class="lead">{lead}</p>
</header>
