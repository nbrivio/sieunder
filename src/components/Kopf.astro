---
import Hinweisband from './Hinweisband.astro';
import { betrieb, telefonZiel, telefonAnzeige } from '../inhalt/betrieb.js';
import { pfad } from '../inhalt/pfad.js';
---

<header class="kopf">
  <Hinweisband />
  <div class="innen zeile">
    <!-- Wortmarke als Text, bis das Logo als Vektor vorliegt. -->
    <a class="marke" href={pfad('/')}>{betrieb.name}</a>
    <a class="ziel" href={telefonZiel}>{telefonAnzeige}</a>
  </div>
</header>

<style>
  .kopf {
    border-bottom: 1px solid var(--se-linie);
  }
  .zeile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--kopf-h);
  }
  .marke {
    padding-block: 0.35rem;
    color: var(--se-tinte);
    font-family: var(--se-font-titel);
    font-size: 1.375rem;
    text-decoration: none;
  }
  .ziel {
    font-size: var(--fs-klein);
    white-space: nowrap;
  }
</style>
