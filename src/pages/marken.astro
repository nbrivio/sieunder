---
import '../stile/unterseite.css';
import Seite from '../layouts/Seite.astro';
import Betont from '../components/Betont.astro';
import Unterkopf from '../components/Unterkopf.astro';
import BesuchBand from '../components/BesuchBand.astro';
import { marken } from '../inhalt/marken.js';
import { seiten } from '../inhalt/seiten.js';
import kopf from '../assets/bilder/marken-kopf.jpg';

const s = seiten.marken;
const fuer = (wen) => marken.filter((m) => m.fuer.includes(wen));
---

<Seite titel={s.seitentitel} beschreibung={s.beschreibung} pfad={[['Marken', '/marken/']]}>
  <Unterkopf titel={s.titel} lead={s.lead} bild={kopf} alt="Frau im beigen Trenchcoat über einem zartrosa BH sitzt in einem rosa Samtsessel" oben />
  <section class="u-teil leinen" aria-labelledby="t-sie">
    <h2 id="t-sie" class="etikett">Für Sie</h2>
    <ul class="u-inhalt liste-gross">{fuer('sie').map((m) => <li>{m.name}</li>)}</ul>
  </section>
  <section class="u-teil" aria-labelledby="t-er">
    <h2 id="t-er" class="etikett">Für Ihn</h2>
    <ul class="u-inhalt liste-gross">{fuer('er').map((m) => <li>{m.name}</li>)}</ul>
  </section>
  <BesuchBand />
</Seite>
