---
import Seite from '../layouts/Seite.astro';
import { pfad } from '../inhalt/pfad.js';
---

<Seite intern titel="Seite nicht gefunden" beschreibung="Diese Adresse gibt es nicht.">
  <section class="leer" aria-labelledby="leer-titel">
    <h1 id="leer-titel" class="gross">Diese Seite gibt es <em>nicht</em></h1>
    <p>Vielleicht ist sie umgezogen.</p>
    <p><a class="knopf" href={pfad('/')}>Zur Startseite</a></p>
  </section>
</Seite>

<style>
  .leer {
    display: grid;
    gap: 24px;
    justify-items: start;
    min-height: 70svh;
    padding: clamp(140px, 18vw, 220px) var(--rand) 80px;
  }
  h1 {
    font-size: clamp(44px, 8vw, 110px);
    line-height: 0.95;
  }
</style>
