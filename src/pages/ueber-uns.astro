---
import { Image } from 'astro:assets';
import '../stile/unterseite.css';
import Seite from '../layouts/Seite.astro';
import Betont from '../components/Betont.astro';
import { seiten } from '../inhalt/seiten.js';
import { start } from '../inhalt/start.js';
import { pfad } from '../inhalt/pfad.js';
import laden1 from '../assets/bilder/laden-1.jpg';
import laden2 from '../assets/bilder/laden-2.jpg';

const s = seiten.ueber;
---

<Seite titel={s.seitentitel} beschreibung={s.beschreibung} pfad={[['Über uns', '/ueber-uns/']]}>
  <header class="u-kopf">
    <h1 class="gross"><Betont text={s.titel} /></h1>
    <p class="lead">{start.menschen.text}</p>
  </header>
  <section class="u-teil leinen" aria-labelledby="t-wir">
    <h2 id="t-wir" class="gross"><Betont text={start.menschen.namen} /></h2>
    <div class="u-inhalt">
      {start.menschen.bildHinweis && <p class="m-bild">{start.menschen.bildHinweis}</p>}
    </div>
  </section>
  <section class="u-teil" aria-labelledby="t-laden">
    <h2 id="t-laden" class="gross"><Betont text={s.ladenTitel} /></h2>
    <div class="u-inhalt">
      <p>{start.laden.text}</p>
    </div>
    <figure class="u-ganz u-bild"><Image src={laden1} alt="Blick durch den Laden: Präsentationstisch mit Dessous, Kommoden und Wäsche an den Wänden" widths={[640, 960, 1500]} sizes="100vw" quality={72} /></figure>
    <figure class="u-ganz u-bild"><Image src={laden2} alt="Sitzecke im Laden mit Bistrotisch, Spiegel und Wäsche an der Wand" widths={[640, 960, 1500]} sizes="100vw" quality={72} /></figure>
  </section>
  <section class="u-teil rose" aria-label="Besuch">
    <div class="u-ganz wege"><a class="knopf" href={pfad('/#besuch')}>Besuch planen</a></div>
  </section>
</Seite>
