---
import { Image } from 'astro:assets';
import '../stile/seite.css';
import Seite from '../layouts/Seite.astro';
import Betont from '../components/Betont.astro';
import { betrieb, route, telefonZiel, telefonAnzeige, zeitenMinuten } from '../inhalt/betrieb.js';
import { marken } from '../inhalt/marken.js';
import { start } from '../inhalt/start.js';
import { istLive } from '../inhalt/stufe.js';
import { pfad } from '../inhalt/pfad.js';
import kopf from '../assets/bilder/kopf.jpg';
import tag1 from '../assets/bilder/tag-1.jpg';
import tag2 from '../assets/bilder/tag-2.jpg';
import tag3 from '../assets/bilder/tag-3.jpg';
import tag4 from '../assets/bilder/tag-4.jpg';
import nacht1 from '../assets/bilder/nacht-1.jpg';
import nacht3 from '../assets/bilder/nacht-3.jpg';
import laden1 from '../assets/bilder/laden-1.jpg';
import laden2 from '../assets/bilder/laden-2.jpg';

if (istLive && !start.freigegeben) {
  throw new Error('Die Texte der Startseite sind noch nicht freigegeben (inhalt/start.json).');
}

const breiten = [480, 800, 1200];

// Produktbilder je Marke. Fehlt die Datei zu einem Eintrag, bricht der Bau ab.
const markenDateien = import.meta.glob('../assets/bilder/marken/*.{jpg,png}', { eager: true });
const markenBilder = marken.filter((m) => m.bild).map((m) => {
  const datei = Object.entries(markenDateien).find(([pfadName]) => pfadName.endsWith(`/${m.bild}`));
  if (!datei) throw new Error(`Bild zur Marke ${m.name} fehlt: src/assets/bilder/marken/${m.bild}`);
  return { name: m.name, bild: datei[1].default };
});
// Tag- und Nachtsatz teilen den Anfang; nur die betonte Stelle und das Verb wechseln. Beide bekommen eigene Zeilen,
// damit die Sätze beim Überblenden genau aufeinanderliegen.
const zerlegt = (text) => {
  const [, vor, betont, nach] = text.match(/^(.*?)\s*\*(.+)\*\s*(.*)$/);
  return { vor, betont, nach };
};
const tag = zerlegt(start.collage);
const nacht = zerlegt(start.collageNacht);
if (tag.vor !== nacht.vor) throw new Error('Tag- und Nachtsatz der Collage müssen gleich beginnen (inhalt/start.json).');
// Jeder Satz der Einleitung steht auf eigener Zeile. Zahl und folgendes Wort bleiben zusammen,
// ebenso die letzten zwei Worte eines Satzes, damit nie ein Wort allein auf die Zeile rutscht.
// Jede Zeile ist ein Satz; der Zeilenumbruch schliesst ihn, darum steht am Ende kein Punkt.
const leadSaetze = start.lead.split(/(?<=\.)\s+/).map((satz) => satz.replace(/\.$/, '').replace(/(\d) /g, '$1\u00a0').replace(/ (\S+)$/, '\u00a0$1'));
const halb = '(max-width: 860px) 64vw, 34vw';
const drittel = '(max-width: 860px) 46vw, 27vw';
---

<Seite start titel={start.seitentitel} beschreibung={start.beschreibung}>
  <section class="auftakt" data-roll>
    <div class="haft">
      <p class="a-paar gross" aria-hidden="true"><span>für Sie</span><span><em>für Ihn</em></span></p>
      <figure class="a-karte">
        <Image src={kopf} alt="Frau in zartrosa Spitzen-BH und heller Leinenhose sitzt vor einer terrakottafarbenen Wand und blickt nachdenklich zur Seite" widths={[640, 800, 960, 1440, 1966]} sizes="100vw" quality={72} loading="eager" fetchpriority="high" />
      </figure>
      <div class="a-text">
        <p class="etikett status" data-zeiten={JSON.stringify(zeitenMinuten)}><i aria-hidden="true"></i><span>Dienstag bis Samstag für dich da</span></p>
        <h1 class="gross"><Betont text={start.titel} /></h1>
        <p class="lead">{leadSaetze.map((satz) => <span class="satzzeile">{satz}</span>)}</p>
        <a class="knopf" href={pfad('/#besuch')}>Besuch planen</a>
      </div>
    </div>
  </section>

  <section class="satz" aria-label="Unser Versprechen">
    <p class="gross" data-worte><Betont text={start.satz} /></p>
  </section>

  <section id="marken" class="marken" aria-labelledby="t-marken">
    <h2 id="t-marken" class="etikett">{start.markenTitel}</h2>
    <ul class="zeile" data-worte>{marken.map((m) => <li data-hat-bild={m.bild ? m.name : undefined}>{m.name}</li>)}</ul>
    {markenBilder.length > 0 && (
      <div class="m-schau" data-schau aria-hidden="true">
        <figure>{markenBilder.map((m) => <Image src={m.bild} alt="" data-marke={m.name} widths={[320, 640]} sizes="(max-width: 860px) 60vw, 22vw" quality={72} />)}</figure>
      </div>
    )}
    <p class="weiter"><a href={pfad('/marken/')}>Alle Marken ansehen</a></p>
  </section>

  <section class="collage" data-roll aria-label="Stimmung">
    <div class="haft">
      <p class="c-satz c-tag gross">{tag.vor} <em class="c-zeile">{tag.betont}</em> <span class="c-zeile">{tag.nach}</span></p>
      <figure class="c-bild c-1"><Image src={tag1} alt="Frau im beigen Trenchcoat über einem zartrosa BH sitzt in einem rosa Samtsessel" widths={breiten} sizes={halb} quality={70} /></figure>
      <figure class="c-bild c-2"><Image src={tag2} alt="Frau in dunkler Spitzenwäsche lehnt an einer Ballettstange" widths={breiten} sizes={halb} quality={70} /></figure>
      <figure class="c-bild c-3"><Image src={tag3} alt="Frau in zartrosa BH und offenem Trenchcoat lehnt lächelnd im Sessel" widths={breiten} sizes={halb} quality={70} /></figure>
      <figure class="c-bild c-4"><Image src={tag4} alt="Mann in Loungewear liegt entspannt auf einer Lederbank" widths={breiten} sizes={halb} quality={70} /></figure>
      <p class="c-satz c-nacht gross">{nacht.vor} <em class="c-zeile">{nacht.betont}</em> <span class="c-zeile">{nacht.nach}</span></p>
      <div class="c-ende">
        <figure class="c-n c-n1"><Image src={nacht1} alt="Zwei Frauen in Nachtwäsche aus Satin, die eine im hellen Top mit Spitze, die andere im gemusterten Pyjama" widths={[480, 800]} sizes={drittel} quality={72} /></figure>
        <figure class="c-n c-n3"><Image src={nacht3} alt="Mann im dunkelblauen Pyjama lehnt an einer Betonwand" widths={[480, 800]} sizes={drittel} quality={72} /></figure>
      </div>
    </div>
  </section>

  <section id="laden" class="laden" data-sicht aria-labelledby="t-laden">
    <figure class="l-gross"><Image src={laden1} alt="Blick durch den Laden: Präsentationstisch mit Dessous, Kommoden und Wäsche an den Wänden" widths={[640, 960, 1500]} sizes="(max-width: 860px) 100vw, 62vw" quality={72} /></figure>
    <div class="l-text">
      <h2 id="t-laden" class="gross"><Betont text={start.laden.titel} /></h2>
      <p>{start.laden.text}</p>
      <p class="etikett"><a class="ort" href={route} rel="noopener">{betrieb.strasse}, {betrieb.ort}</a></p>
    </div>
    <figure class="l-klein"><Image src={laden2} alt="Sitzecke im Laden mit Bistrotisch, Spiegel und Wäsche an der Wand" widths={[480, 800]} sizes="(max-width: 860px) 82vw, 30vw" quality={72} /></figure>
  </section>

  <section id="menschen" class="menschen" aria-labelledby="t-menschen">
    {start.menschen.bildHinweis && <p class="m-bild">{start.menschen.bildHinweis}</p>}
    <div class="m-text">
      <h2 id="t-menschen" class="etikett">{start.menschen.etikett}</h2>
      <p class="gross"><Betont text={start.menschen.namen} /></p>
      <p>{start.menschen.text}</p>
      <p><a class="mehr" href={pfad('/ueber-uns/')}>Mehr über uns</a></p>
    </div>
  </section>

  <section id="beratung" class="satz" aria-labelledby="t-beratung">
    <h2 id="t-beratung" class="etikett">{start.beratung.etikett}</h2>
    <p class="gross" data-worte><Betont text={start.beratung.satz} /></p>
  </section>

  <section id="brustprothesen" class="sanft" aria-labelledby="t-sanft">
    <div class="s-links">
      <h2 id="t-sanft" class="etikett">{start.brust.etikett}</h2>
      <p class="gross" data-worte><Betont text={start.brust.satz} /></p>
    </div>
    <div class="s-rechts">
      <p>{start.brust.text}</p>
      <dl class="punkte">
        {start.brust.punkte.map((punkt) => (<div><dt>{punkt.begriff}</dt><dd>{punkt.text}</dd></div>))}
      </dl>
      <div class="wege">
        <a class="knopf" href={telefonZiel}>{telefonAnzeige}</a>
        <a href={`mailto:${betrieb.email}`}>{betrieb.email}</a>
        <a href={pfad('/beratung/brustprothesen/')}>So läuft ein Termin ab</a>
      </div>
    </div>
  </section>
</Seite>
